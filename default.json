{
  "extends": [
    "config:recommended",
    "group:apache-camelMonorepo",
    "group:allApollographql",
    "group:fortawesome",
    "group:fusionjs",
    "group:glimmer",
    "group:goOpenapi",
    "group:hibernateCore",
    "group:hibernateValidator",
    "group:hibernateOgm",
    "group:hibernateCommons",
    "group:illuminate",
    "group:jekyllEcosystem",
    "group:polymer",
    "group:resilience4j",
    "group:rubyOmniauth",
    "group:socketio",
    "group:springAmqp",
    "group:springAndroid",
    "group:springBatch",
    "group:springBoot",
    "group:springCloud",
    "group:springCore",
    "group:springData",
    "group:springHateoas",
    "group:springIntegration",
    "group:springKafka",
    "group:springLdap",
    "group:springMobile",
    "group:springOsgi",
    "group:springRestDocs",
    "group:springRoo",
    "group:springScala",
    "group:springSecurity",
    "group:springSession",
    "group:springShell",
    "group:springSocial",
    "group:springStatemachine",
    "group:springWebflow",
    "group:springWs",
    "group:symfony",
    "regexManagers:dockerfileVersions",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Oslo",
  "platformAutomerge": true,
  "enabledManagers": ["maven", "npm", "circleci", "dockerfile", "gradle", "gradle-wrapper", "pip", "github-actions", "helm-values"],
  "rangeStrategy": "pin",
  "commitMessageExtra" : "from v{{currentVersion}} to {{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{toVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}",
  "prConcurrentLimit": 20,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "matchDatasources": [
        "maven"
      ],
      "registryUrls": [
        "https://repo1.maven.org/maven2",
        "https://plugins.gradle.org/m2/",
        "https://maven.google.com/",
        "https://jitpack.io",
        "https://scandit.bintray.com/DataCapture",
        "https://repo.osgeo.org/",
        "https://packages.confluent.io/maven"
      ]
    },
    {
      "groupName": "Entur packages",
      "matchPackagePatterns": ["^@entur/"],
      "managers": ["npm"]
    },
    {
      "matchPackageNames": ["org.sonatype.plugins:nexus-staging-maven-plugin"],
      "enabled": false
    },
    {
      "description": "Automerge non-major updates once the release-age cooldown has passed",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Do not automerge Camel minor releases (not SemVer compliant: breaking changes may occur)",
      "matchPackageNames": [
        "org.apache.camel.springboot:camel-spring-boot-bom"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Do not automerge Logback minor releases (not SemVer compliant: version 1.2 is compatible with SLF4J 1 and version 1.3+ is compatible with SLF4J 2)",
      "matchPackageNames": [
        "ch.qos.logback:logback-classic"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Avoid attempts to upgrade to non-release tags such as v230521",
      "matchPackageNames": [
        "com.graphql-java:graphql-java",
        "com.graphql-java:graphql-java-extended-scalars"
      ],
      "versioning": "semver-coerced"
    },
    {
      "matchPackageNames": ["org.sonatype.plugins:nexus-staging-maven-plugin"],
      "enabled": false
    },
    {
      "groupName": "vite packages",
      "matchPackagePatterns": [
        "^vite", "^@vitejs/"
      ]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["bellsoft/liberica-openjre-alpine"],
      "versioning": "loose"
    },
    {
      "description": "Require a 4-day release-age cooldown for all packages before updating",
      "minimumReleaseAge": "4 days"
    },
    {
      "description": "Exempt Entur-published packages from the release-age cooldown (automerged immediately via the non-major rule above)",
      "matchPackagePatterns": ["^@entur/", "^org\\.entur", "^org\\.rutebanken"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "google/cloud-sdk does not follow semver, automerge all updates (cooldown still applies)",
      "matchPackageNames": ["google/cloud-sdk"],
      "automerge": true
    }
  ]
}
